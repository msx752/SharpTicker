    <PackageReference Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpTicker\SharpTicker.csproj" />
    <ProjectReference Include="..\..\src\SharpTicker.Utilities\SharpTicker.Utilities.csproj" />
    <ProjectReference Include="..\..\src\SharpTicker.Caching.StackExchangeRedis\SharpTicker.Caching.StackExchangeRedis.csproj" />
  </ItemGroup>

</Project>
