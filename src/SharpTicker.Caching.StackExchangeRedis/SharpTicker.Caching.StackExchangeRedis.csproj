<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>SharpTicker.Caching.StackExchangeRedis</PackageId>
        <Title>SharpTicker StackExchange.Redis Caching</Title>
        <Description>Redis caching and distributed synchronization provider for SharpTicker job scheduler using StackExchange.Redis</Description>
        <PackageTags>$(PackageTags);Redis;Caching;Distributed;StackExchange</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
      <EmbeddedResource Include="Scripts\*.lua" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(DotNetVersion)" />
      <ProjectReference Include="../SharpTicker.Utilities/SharpTicker.Utilities.csproj" />
    </ItemGroup>
</Project>
